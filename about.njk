- name: "about"
        label: "About Page"
        file: "about.njk"
        fields:
          - { label: "Page Title (browser tab)", name: "title", widget: "string" }
          - { label: "Description (for search engines)", name: "description", widget: "text" }
          - label: "Hero (top banner)"
            name: "hero"
            widget: "object"
            fields:
              - { label: "Background Photo", name: "image", widget: "image" }
              - { label: "Photo Description (for accessibility)", name: "imageAlt", widget: "string" }
              - { label: "Headline", name: "heading", widget: "string" }
          - label: "'You Will Grow' Section"
            name: "grow"
            widget: "object"
            fields:
              - { label: "Heading", name: "heading", widget: "string" }
              - { label: "Paragraph", name: "paragraph", widget: "text" }
          - label: "'You Belong Here' Section"
            name: "belong"
            widget: "object"
            fields:
              - { label: "Heading", name: "heading", widget: "string" }
              - { label: "Paragraph", name: "paragraph", widget: "text" }
          - label: "Meet Our Pastor"
            name: "pastor"
            widget: "object"
            fields:
              - { label: "Pastor Photo", name: "image", widget: "image" }
              - { label: "Photo Description (for accessibility)", name: "imageAlt", widget: "string" }
              - { label: "Bio", name: "bio", widget: "text" }
          - label: "Our History"
            name: "history"
            widget: "object"
            fields:
              - { label: "History Photo", name: "image", widget: "image" }
              - { label: "Photo Description (for accessibility)", name: "imageAlt", widget: "string" }
              - { label: "Paragraph 1", name: "paragraph1", widget: "text" }
              - { label: "Paragraph 2", name: "paragraph2", widget: "text" }
              - { label: "Paragraph 3", name: "paragraph3", widget: "text" }
              - { label: "Paragraph 4", name: "paragraph4", widget: "text" }

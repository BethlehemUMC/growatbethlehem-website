              - { label: "Headline", name: "heading", widget: "string" }
          - label: "Intro"
            name: "intro"
            widget: "object"
            fields:
              - { label: "Bible Verse", name: "verse", widget: "string" }
              - { label: "Paragraph", name: "paragraph", widget: "text" }
          - label: "In Worship"
            name: "inWorship"
            widget: "object"
            fields:
              - { label: "Detail", name: "detail", widget: "text" }
          - label: "By Mail"
            name: "byMail"
            widget: "object"
            fields:
              - { label: "Detail", name: "detail", widget: "text" }
          - label: "Automatic Bank Gift (ACH)"
            name: "automaticBank"
            widget: "object"
            fields:
              - { label: "Detail", name: "detail", widget: "text" }
          - label: "By Text"
            name: "byText"
            widget: "object"
            fields:
              - { label: "Text Code", name: "code", widget: "string" }
              - { label: "Short Number", name: "number", widget: "string" }

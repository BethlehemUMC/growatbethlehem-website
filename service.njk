community:
  heading: "In Our Community"
  paragraph1: "For nearly 30 years, Bethlehem has been a founding partner of the Common Cup Ministry, a coalition of churches serving McLeod County. Through Common Cup, our congregation hosts the annual Fall Coat Giveaway, prepares and serves meals, and provides school supplies, personal care items, and emergency shelter support to neighbors in need."
  paragraph2: "We also maintain a long-standing partnership with the McLeod County Food Shelf, delivering donations twice a month and contributing financially — including a $10,000 gift in 2025 — to help meet growing need across the county."
  image: "/images/coat-drive-sorting-by-size-0a16cecab6.jpg"
  imageAlt: "Coat drive sorting by size"
foodForKidz:
  heading: "Food for Kidz"
  paragraph: "For 12 years running, Bethlehem has funded and hosted a Food for Kidz meal-packing event — bringing together nearly 140 volunteers, from senior citizens to the local high school football team, to pack meals for food shelves here and around the world."
  stat: "Nearly 40,000 meals packed in 2025."
  image: "/images/food-for-kidz-volunteers-packing-meals-775c8e4ca2.jpg"
  imageAlt: "Food for Kidz volunteers packing meals"
trunkOrTreat:
  heading: "Trunk or Treat"
  paragraph: "Each fall, Bethlehem opens its doors — and its trunks — for a community-wide Trunk or Treat, now a 12-year tradition. It's become a favorite not just for our congregation but for neighbors across Hutchinson, many of whom volunteer their own vehicles and time."
  stat: "More than 400 children attend each year."
  image: "/images/trunk-or-treat-9f7020deb8.jpg"
  imageAlt: "Trunk or Treat"
midwestMission:
